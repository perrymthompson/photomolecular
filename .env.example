# Public environment (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never commit real values
SUPABASE_SERVICE_ROLE_KEY=

# Optional data source override for localhost / preview testing:
#   auto   = prefer Supabase when configured, otherwise local fallback
#   remote = require Supabase and fail loudly if it is unavailable
#   local  = ignore Supabase and use data/csv + data/metadata.json
PLOT_DATA_SOURCE=auto

# Optional: protect write APIs later
# DASHBOARD_SECRET=
